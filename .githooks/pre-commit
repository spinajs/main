#!/bin/sh
# Rides a graph refreshed by `graphify update .` (or the pre-push rebuild) along with
# the next commit, so the versioned graphify-out/ never lags behind the code for long.
#   GRAPHIFY_SKIP_STAGE=1 git commit ...   leave graph changes out of one commit
if [ "${GRAPHIFY_SKIP_STAGE:-0}" != "1" ] && [ -f graphify-out/graph.json ]; then
  git add -- graphify-out/graph.json graphify-out/graph.html graphify-out/GRAPH_REPORT.md
fi

# core.hooksPath bypasses .git/hooks; keep any hook installed there running.
legacy="$(git rev-parse --git-common-dir)/hooks/pre-commit"
[ -f "$legacy" ] && exec sh "$legacy" "$@"
exit 0
