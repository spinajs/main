{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "unresolved",
    "binaries"
  ],
  "ignore": [
    "packages/*/lib/**"
  ],
  "typedoc": false,
  "rules": {
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "unresolved": "warn",
    "binaries": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,js}"
      ],
      "ignoreDependencies": [
        "@spinajs/.*",
        "@arethetypeswrong/cli"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/http-socket-example": {
      "entry": [
        "src/main.ts",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
