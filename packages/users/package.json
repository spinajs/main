{
  "name": "@spinajs/users",
  "version": "3.0.23",
  "description": "User identity for SpinaJS: users, metadata, lifecycle actions and mails",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./queue": {
      "types": "./lib/queue/index.d.ts",
      "import": "./lib/queue/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "queue": [
        "lib/queue/index.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.11"
  },
  "scripts": {
    "build": "npm run clean && npm run compile && npm run copy",
    "compile": "tsc -b tsconfig.build.json",
    "copy": "cpx \"src/templates/**/*.pug\" lib/templates/",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json && ts-mocha -p tsconfig.json --config .mocharc.http.json",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/users",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "rbac"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authn": "3.0.23",
    "@spinajs/authn-local": "3.0.23",
    "@spinajs/authz": "3.0.23",
    "@spinajs/authz-rbac": "3.0.23",
    "@spinajs/cli": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/email": "3.0.23",
    "@spinajs/email-verification": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/hooks": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/queue": "3.0.23",
    "@spinajs/util": "3.0.23",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "@spinajs/authz-queue": "3.0.23"
  },
  "peerDependenciesMeta": {
    "@spinajs/authz-queue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/authn-session": "3.0.23",
    "@spinajs/authn-testing": "3.0.23",
    "@spinajs/authz-abac": "3.0.23",
    "@spinajs/authz-http": "3.0.23",
    "@spinajs/authz-orm": "3.0.23",
    "@spinajs/authz-queue": "3.0.23",
    "@spinajs/authz-testing": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/http": "3.0.23",
    "@spinajs/orm-mssql": "3.0.23",
    "@spinajs/orm-mysql": "3.0.23",
    "@spinajs/orm-postgres": "3.0.23",
    "@spinajs/orm-sqlite": "3.0.23",
    "cpx": "^1.5.0"
  },
  "types": "./lib/index.d.ts"
}
