{
  "name": "@spinajs/users",
  "version": "3.0.0-alpha.0",
  "description": "User identity for SpinaJS: users, metadata, lifecycle actions and mails",
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "types": "./lib/mjs/index.d.ts",
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./queue": {
      "types": "./lib/mjs/queue/index.d.ts",
      "import": "./lib/mjs/queue/index.js",
      "require": "./lib/cjs/queue/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "queue": [
        "lib/cjs/queue/index.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.11"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.mjs.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json && ts-mocha -p tsconfig.json --config .mocharc.http.json",
    "coverage": "nyc npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint -c .eslintrc.cjs --ext .ts src --fix",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "rbac"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authn": "3.0.0-alpha.0",
    "@spinajs/authn-local": "3.0.0-alpha.0",
    "@spinajs/authz": "3.0.0-alpha.0",
    "@spinajs/authz-rbac": "3.0.0-alpha.0",
    "@spinajs/cli": "2.0.549",
    "@spinajs/configuration": "2.0.549",
    "@spinajs/di": "2.0.549",
    "@spinajs/email": "2.0.549",
    "@spinajs/exceptions": "2.0.549",
    "@spinajs/log": "2.0.549",
    "@spinajs/orm": "2.0.549",
    "@spinajs/queue": "2.0.549",
    "@spinajs/reflection": "2.0.549",
    "@spinajs/util": "2.0.549",
    "@spinajs/validation": "2.0.549",
    "accesscontrol": "^2.2.1",
    "argon2": "^0.44.0",
    "entropy-string": "^4.2.0",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "@spinajs/authz-queue": "3.0.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@spinajs/authz-queue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/authn-http": "3.0.0-alpha.0",
    "@spinajs/authn-session": "3.0.0-alpha.0",
    "@spinajs/authn-testing": "3.0.0-alpha.0",
    "@spinajs/authz-abac": "3.0.0-alpha.0",
    "@spinajs/authz-http": "3.0.0-alpha.0",
    "@spinajs/authz-orm": "3.0.0-alpha.0",
    "@spinajs/authz-queue": "3.0.0-alpha.0",
    "@spinajs/authz-testing": "3.0.0-alpha.0",
    "@spinajs/fs": "2.0.549",
    "@spinajs/http": "2.0.549",
    "@spinajs/orm-mssql": "2.0.549",
    "@spinajs/orm-mysql": "2.0.549",
    "@spinajs/orm-postgres": "2.0.549",
    "@spinajs/orm-sqlite": "2.0.549",
    "@types/entropy-string": "^4.2.0"
  },
  "gitHead": "002dc553b0ffffd72193d0121ac425a4083bc9ee"
}
