{
  "name": "@spinajs/tenancy-http",
  "version": "3.0.23",
  "description": "Tenant resolution for SpinaJS http routes and sockets: resolvers, the route middleware that establishes the tenant scope, and the route declarations",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./socket": {
      "types": "./lib/socket.d.ts",
      "import": "./lib/socket.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "clean": "rimraf lib/ && rimraf tsconfig.build.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json \"test/**/*.test.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/tenancy-http"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "tenancy",
    "multi-tenant",
    "http"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/http": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/principal": "3.0.23",
    "@spinajs/tenancy": "3.0.23"
  },
  "peerDependencies": {
    "@spinajs/http-socket": "3.0.23"
  },
  "peerDependenciesMeta": {
    "@spinajs/http-socket": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/fs": "3.0.23",
    "@spinajs/http-socket": "3.0.23",
    "@spinajs/testing": "3.0.23",
    "socket.io-client": "^4.8.1"
  },
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
