{
  "name": "@spinajs/orm-mysql",
  "version": "3.0.23",
  "description": "orm mysql integration",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/*.test.ts",
    "test:integration": "ts-mocha -p tsconfig.json test/integration/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf api-docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/orm-mysql",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "di",
    "container",
    "spinajs",
    "di"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "devDependencies": {
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "@types/ssh2": "^1.5.5",
    "@spinajs/log": "3.0.23",
    "@spinajs/telemetry-common": "3.0.23"
  },
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/orm-sql": "3.0.23",
    "mysql2": "^3.0.1",
    "ssh2": "^1.17.0",
    "asn1": "^0.2.6",
    "bcrypt-pbkdf": "^1.0.2"
  },
  "types": "./lib/index.d.ts"
}
