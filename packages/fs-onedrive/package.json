{
  "name": "@spinajs/fs-onedrive",
  "version": "3.0.23",
  "description": "wrapper for file operations in onedrive",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/fs-onedrive",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/exceptions.git"
  },
  "keywords": [
    "di",
    "container",
    "spinajs",
    "di"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/core)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/exceptions/issues"
  },
  "homepage": "https://github.com/spinajs/exceptions#readme",
  "dependencies": {
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@azure/identity": "^3.1.3",
    "@azure/msal-node": "^1.9.1",
    "@microsoft/microsoft-graph-client": "^3.0.5",
    "archiver": "^5.3.1",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.1",
    "@types/luxon": "^3.6.1",
    "@types/uuid": "^9.0.0"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
