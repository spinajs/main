{
  "name": "@spinajs/orm",
  "version": "3.0.23",
  "description": "framework orm module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf api-docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/orm",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "di",
    "container",
    "spinajs",
    "di"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "devDependencies": {
    "@spinajs/manifest": "3.0.23",
    "@spinajs/testing": "3.0.23",
    "@types/lodash": "4.14.191",
    "@types/luxon": "^3.6.1",
    "@types/node": "^22.14.1",
    "@types/uuid": "9.0.0"
  },
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/manifest": "3.0.23",
    "@spinajs/reflection": "3.0.23",
    "@spinajs/telemetry-common": "3.0.23",
    "@spinajs/validation": "3.0.23",
    "glob": "^8.1.0",
    "glob-to-regexp": "^0.4.1",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "uuid": "^9.0.0"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
