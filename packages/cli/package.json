{
  "name": "@spinajs/cli",
  "version": "3.0.23",
  "description": "SpinaJS command line module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/cli",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "bin": {
    "spinajs": "./lib/cli.js"
  },
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/core)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/spinajs/reflection/issues"
  },
  "homepage": "https://github.com/spinajs/reflection#readme",
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/internal-logger": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/manifest": "3.0.23",
    "@spinajs/reflection": "3.0.23",
    "commander": "10.0.0",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@spinajs/asyncapi": "3.0.23",
    "@spinajs/compiler": "3.0.23",
    "@spinajs/codemods": "3.0.23",
    "@spinajs/client": "3.0.23",
    "@spinajs/openapi": "3.0.23"
  },
  "types": "./lib/index.d.ts",
  "peerDependencies": {
    "@spinajs/asyncapi": "3.0.23",
    "@spinajs/compiler": "3.0.23",
    "@spinajs/codemods": "3.0.23",
    "@spinajs/client": "3.0.23",
    "@spinajs/openapi": "3.0.23"
  },
  "peerDependenciesMeta": {
    "@spinajs/asyncapi": {
      "optional": true
    },
    "@spinajs/compiler": {
      "optional": true
    },
    "@spinajs/codemods": {
      "optional": true
    },
    "@spinajs/client": {
      "optional": true
    },
    "@spinajs/openapi": {
      "optional": true
    }
  },
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
