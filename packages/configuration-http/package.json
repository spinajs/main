{
  "name": "@spinajs/configuration-http",
  "version": "3.0.23",
  "description": "API for configuration module. Allows to set / get configuration values from db",
  "author": "Grzegorz Beń <grzegorz.ben@coderush.pl>",
  "homepage": "https://github.com/spinajs/main#readme",
  "license": "ISC",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/configuration-http",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "keywords": [
    "spinajs",
    "configuration"
  ],
  "devDependencies": {
    "@spinajs/authz-testing": "3.0.23",
    "@spinajs/orm-sqlite": "3.0.23",
    "@types/lodash": "^4.14.191",
    "@types/luxon": "^3.2.0"
  },
  "dependencies": {
    "@spinajs/authz": "3.0.23",
    "@spinajs/authz-http": "3.0.23",
    "@spinajs/authz-orm": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/configuration-db-source": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/http": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/orm-http": "3.0.23",
    "@spinajs/validation": "3.0.23",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1"
  },
  "types": "./lib/index.d.ts"
}
