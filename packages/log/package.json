{
  "name": "@spinajs/log",
  "version": "3.0.23",
  "description": "Log lib for all spinejs related libs",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": "./lib/index.js",
      "browser": "./lib/index.browser.js"
    },
    "./browser": "./lib/index.browser.js"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts --exit",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/log",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/log)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/log/issues"
  },
  "homepage": "https://github.com/spinajs/log#readme",
  "dependencies": {
    "@colors/colors": "^1.5.0",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/internal-logger": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/util": "3.0.23",
    "ajv": "^8.12.0",
    "cron": "^2.2.0",
    "glob-to-regexp": "^0.4.1",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "@types/cron": "^2.0.0",
    "@types/glob-to-regexp": "^0.4.1",
    "@types/node-schedule": "^2.1.0"
  },
  "types": "./lib/index.d.ts"
}
