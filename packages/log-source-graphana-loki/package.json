{
  "version": "3.0.23",
  "description": "Log lib for all spinejs related libs",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha --exit -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/log-source-graphana-loki",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/log)",
  "license": "MIT",
  "name": "@spinajs/log-source-graphana-loki",
  "homepage": "https://github.com/spinajs/main#readme",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "dependencies": {
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/util": "3.0.23",
    "axios": "^1.2.3",
    "lodash": "^4.17.21"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
