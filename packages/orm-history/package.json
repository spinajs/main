{
  "name": "@spinajs/orm-history",
  "version": "3.0.23",
  "description": "Row history of SpinaJS ORM models, recorded in an audit trail: @History, audit.data.rules and history reads",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "clean": "rimraf lib/ && rimraf tsconfig.build.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json",
    "lint": "cd ../.. && npm run lint -- packages/orm-history"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "orm",
    "history",
    "audit"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/audit": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/orm": "3.0.23"
  },
  "devDependencies": {
    "@spinajs/log": "3.0.23",
    "@spinajs/testing": "3.0.23"
  }
}
