{
  "name": "@spinajs/authn",
  "version": "3.0.23",
  "description": "Authentication core for SpinaJS: contracts, flow, throttling",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./contracts": {
      "types": "./lib/contracts/index.d.ts",
      "import": "./lib/contracts/index.js"
    },
    "./env": {
      "types": "./lib/service/boot/env.d.ts",
      "import": "./lib/service/boot/env.js"
    },
    "./boot": {
      "types": "./lib/service/boot/index.d.ts",
      "import": "./lib/service/boot/index.js"
    },
    "./schemas": {
      "types": "./lib/schemas/index.d.ts",
      "import": "./lib/schemas/index.js"
    },
    "./register-schema": {
      "types": "./lib/register-schema.d.ts",
      "import": "./lib/register-schema.js"
    },
    "./mfa-enrolments": {
      "types": "./lib/flow/mfa-enrolments.d.ts",
      "import": "./lib/flow/mfa-enrolments.js"
    },
    "./store-throttle": {
      "types": "./lib/throttle/store-throttle.d.ts",
      "import": "./lib/throttle/store-throttle.js"
    },
    "./nonces": {
      "types": "./lib/nonces/index.d.ts",
      "import": "./lib/nonces/index.js"
    },
    "./bus": {
      "types": "./lib/bus/index.d.ts",
      "import": "./lib/bus/index.js"
    },
    "./audit": {
      "types": "./lib/audit/authn-audit.d.ts",
      "import": "./lib/audit/authn-audit.js"
    },
    "./ip-key": {
      "types": "./lib/support/ip-key.d.ts",
      "import": "./lib/support/ip-key.js"
    },
    "./hooks": {
      "types": "./lib/hooks.d.ts",
      "import": "./lib/hooks.js"
    }
  },
  "typesVersions": {
    "*": {
      "contracts": [
        "lib/contracts/index.d.ts"
      ],
      "env": [
        "lib/service/boot/env.d.ts"
      ],
      "boot": [
        "lib/service/boot/index.d.ts"
      ],
      "schemas": [
        "lib/schemas/index.d.ts"
      ],
      "register-schema": [
        "lib/register-schema.d.ts"
      ],
      "mfa-enrolments": [
        "lib/flow/mfa-enrolments.d.ts"
      ],
      "store-throttle": [
        "lib/throttle/store-throttle.d.ts"
      ],
      "nonces": [
        "lib/nonces/index.d.ts"
      ],
      "bus": [
        "lib/bus/index.d.ts"
      ],
      "audit": [
        "lib/audit/authn-audit.d.ts"
      ],
      "ip-key": [
        "lib/support/ip-key.d.ts"
      ],
      "hooks": [
        "lib/hooks.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/authn",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "authn"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/hooks": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/principal": "3.0.23",
    "@spinajs/util": "3.0.23",
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "@spinajs/authn-testing": "3.0.23"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
