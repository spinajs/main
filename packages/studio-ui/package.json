{
  "name": "@spinajs/studio-ui",
  "version": "0.1.0",
  "description": "Spina Studio: the prebuilt web UI that @spinajs/studio serves under /_studio",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://gitlab.coderush.pl/api/v4/packages/npm/",
    "access": "restricted"
  },
  "ckit": {
    "packages": [
      "access",
      "charts",
      "components",
      "core",
      "data",
      "data-grid",
      "i18n",
      "ops",
      "styles",
      "tanstack"
    ]
  },
  "scripts": {
    "clean": "rimraf dist/",
    "dev": "node ../../scripts/require-ckit.mjs vite",
    "build": "node ../../scripts/require-ckit.mjs vite build",
    "typecheck": "node ../../scripts/require-ckit.mjs node ../../node_modules/typescript-7/lib/tsc.js -p tsconfig.json",
    "lint": "node ../../scripts/require-ckit.mjs eslint .",
    "test": "node ../../scripts/require-ckit.mjs vitest run",
    "prepublishOnly": "node ../../scripts/require-ckit.mjs --strict vite build"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@spinajs/studio": "3.0.23",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.52.0",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
