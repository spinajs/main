{
  "name": "@spinajs/http-swagger",
  "version": "3.0.25",
  "description": "Swagger/OpenAPI documentation generator for SpineJS HTTP controllers. Reads route metadata and JSDoc comments to produce OpenAPI 3.0 specs.",
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "types": "./lib/mjs/index.d.ts",
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.11"
  },
  "scripts": {
    "build": "npm run clean && npm run compile && npm run copy",
    "compile": "tsc -b tsconfig.mjs.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "copy": "cpx \"src/views/**/*.{pug,js}\" lib/views/",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json \"test/**/*.test.ts\"",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/http-swagger",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "swagger",
    "openapi",
    "documentation"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/cli": "3.0.25",
    "@spinajs/configuration": "3.0.25",
    "@spinajs/configuration-common": "3.0.25",
    "@spinajs/di": "3.0.25",
    "@spinajs/exceptions": "3.0.25",
    "@spinajs/util": "3.0.25",
    "@spinajs/http": "3.0.25",
    "@spinajs/log": "3.0.25",
    "@spinajs/log-common": "3.0.25",
    "@spinajs/reflection": "3.0.25",
    "@spinajs/fs": "3.0.25",
    "@spinajs/templates": "3.0.25",
    "@spinajs/templates-pug": "3.0.25",
    "@spinajs/validation": "3.0.25",
    "swagger-ui-dist": "^5.0.0"
  },
  "devDependencies": {
    "@spinajs/authz-http": "3.0.25",
    "@spinajs/orm": "3.0.25",
    "cpx": "1.5.0"
  }
}
