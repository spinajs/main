{
  "name": "@spinajs/queue-http-progress",
  "version": "3.0.11",
  "description": "Job status route for SpinaJS queue jobs: GET jobs/v1/:jobId/status returns the status, progress and result of one queue job.",
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "types": "./lib/mjs/index.d.ts",
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.11"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.mjs.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "nyc npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/queue-http-progress",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "http",
    "progress"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authz": "3.0.11",
    "@spinajs/authz-http": "3.0.11",
    "@spinajs/configuration": "3.0.11",
    "@spinajs/di": "3.0.11",
    "@spinajs/exceptions": "3.0.11",
    "@spinajs/http": "3.0.11",
    "@spinajs/log": "3.0.11",
    "@spinajs/queue": "3.0.11",
    "@spinajs/reflection": "3.0.11",
    "@spinajs/fs": "3.0.11",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "@spinajs/authz-orm": "3.0.11",
    "@spinajs/authz-queue": "3.0.11",
    "@spinajs/authz-rbac": "3.0.11",
    "@spinajs/authz-testing": "3.0.11",
    "@spinajs/fs": "3.0.11",
    "@spinajs/orm": "3.0.11",
    "@spinajs/orm-sqlite": "3.0.11",
    "@types/luxon": "^3.6.1"
  }
}
