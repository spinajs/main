{
  "compilerOptions": {
    "target": "ES2022", "module": "node16", "moduleResolution": "node16", "rootDir": "../..", "outDir": "./lib",
    "experimentalDecorators": true, "emitDecoratorMetadata": false, "strict": true, "strictPropertyInitialization": false,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["node"], "noEmit": true
  },
  "include": ["src/**/*"]
}
