<mjml>
  <mj-head>
    <mj-title>{{Subject}}</mj-title>
    <mj-preview>{{Subject}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#1f2933" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f5f7">
    <mj-section padding="24px 0 8px">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="bold">{{AppName}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold">{{Subject}}</mj-text>
        <mj-text>{{#if Name}}Hello {{Name}},{{else}}Hello,{{/if}}</mj-text>
        <mj-text>Someone tried to create an account{{#if AppName}} at {{AppName}}{{/if}} with {{Email}}, but this address already has one.</mj-text>
        <mj-text>If it was you, sign in with your existing password.</mj-text>
        {{#if ActionUrl}}
        <mj-text>If you forgot it, you can set a new one:</mj-text>
        <mj-button href="{{ActionUrl}}" background-color="#2563eb" color="#ffffff" font-size="15px" padding="16px 0">Reset my password</mj-button>
        <mj-text font-size="13px" color="#52606d">If the button does not work, open this link: <a href="{{ActionUrl}}" style="color: #2563eb; word-break: break-all;">{{ActionUrl}}</a></mj-text>
        {{else}}
        <mj-text>If you forgot it, use the password reset option on the sign-in page.</mj-text>
        {{/if}}
      </mj-column>
    </mj-section>
    <mj-section padding="8px 24px 24px">
      <mj-column>
        <mj-text font-size="12px" color="#7b8794">If this was not you, ignore this mail: no new account was created and nothing changed.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
