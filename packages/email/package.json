{
  "name": "@spinajs/email",
  "version": "3.0.23",
  "description": "sending emails easy & reliable way",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "node scripts/test-all.mjs",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/email",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "http"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.821.0",
    "@spinajs/authn": "3.0.23",
    "@spinajs/authn-local": "3.0.23",
    "@spinajs/authn-testing": "3.0.23",
    "@spinajs/authz": "3.0.23",
    "@spinajs/authz-fs": "3.0.23",
    "@spinajs/authz-queue": "3.0.23",
    "@spinajs/authz-rbac": "3.0.23",
    "@spinajs/authz-testing": "3.0.23",
    "@spinajs/fs-s3": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@types/luxon": "^3.6.1",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.7"
  },
  "dependencies": {
    "@spinajs/cli": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/intl": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/queue": "3.0.23",
    "@spinajs/templates-mjml": "3.0.23",
    "@spinajs/util": "3.0.23",
    "luxon": "^3.6.1"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
