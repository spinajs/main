{
  "name": "@spinajs/electron",
  "version": "3.0.23",
  "description": "spinajs extensions for electron",
  "license": "ISC",
  "main": "./lib/index.js",
  "exports": {
    "node": "./lib/index.js",
    "browser": "./lib/renderer.js"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json \"test/**/*.test.ts\"",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/electron",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/di.git"
  },
  "keywords": [
    "di",
    "container",
    "spinajs",
    "di"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/core)",
  "bugs": {
    "url": "https://github.com/spinajs/di/issues"
  },
  "homepage": "https://github.com/spinajs/di#readme",
  "devDependencies": {
    "electron": "^22.0.3"
  },
  "dependencies": {
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/orm-sql": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/authz": "3.0.23"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
