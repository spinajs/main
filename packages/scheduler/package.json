{
  "name": "@spinajs/scheduler",
  "version": "3.0.16",
  "description": "Cluster-safe recurring and manual jobs with run tracking, retries and error grouping",
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "types": "./lib/mjs/index.d.ts",
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.mjs.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json --exit \"test/**/*.test.ts\"",
    "coverage": "nyc npm run test",
    "build-docs": "rimraf api-docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/scheduler",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "scheduler",
    "cron"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@sinonjs/fake-timers": "^10.3.0",
    "@spinajs/cli": "3.0.16",
    "@spinajs/configuration": "3.0.16",
    "@spinajs/di": "3.0.16",
    "@spinajs/exceptions": "3.0.16",
    "@spinajs/log": "3.0.16",
    "@spinajs/log-common": "3.0.16",
    "@spinajs/orm": "3.0.16",
    "@spinajs/queue": "3.0.16",
    "@spinajs/reflection": "3.0.16",
    "@spinajs/telemetry-common": "3.0.16",
    "@spinajs/validation": "3.0.16",
    "cron": "^4.3.0",
    "luxon": "^3.6.1",
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "@spinajs/tasks": "3.0.16"
  },
  "peerDependenciesMeta": {
    "@spinajs/tasks": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/orm-mysql": "3.0.16",
    "@spinajs/orm-postgres": "3.0.16",
    "@spinajs/orm-sqlite": "3.0.16",
    "@spinajs/tasks": "3.0.16",
    "@spinajs/threading": "3.0.16",
    "@types/node": "^22.14.1",
    "@types/sinonjs__fake-timers": "^15.0.1"
  }
}
