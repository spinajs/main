{
  "name": "@spinajs/validation",
  "version": "3.0.23",
  "description": "validation library for spinajs framework",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/validation",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/validation.git"
  },
  "keywords": [
    "spinajs",
    "validation",
    "schema"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/core)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/validation/issues"
  },
  "homepage": "https://github.com/spinajs/validation#readme",
  "devDependencies": {
    "@types/ajv-merge-patch": "^4.1.2"
  },
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "glob": "^8.1.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "ajv-merge-patch": "^5.0.1",
    "lodash": "^4.17.21"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
