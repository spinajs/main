{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "mochaOptions": {
    "config": ".mocharc.stryker.json"
  },
  "testRunnerNodeArgs": [
    "--experimental-specifier-resolution=node",
    "--loader=ts-node/esm"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "inPlace": true,
  "mutate": [
    "src/model/**/*.ts",
    "!src/model/memory.ts",
    "!src/model/rules/**",
    "!src/model/sets/**",
    "!src/model/links/**",
    "!src/model/{service,contributor}.ts",
    "!src/model/ladder/**",
    "!src/model/{evaluate,roles,patterns,fields}.ts"
  ],
  "reporters": [
    "json",
    "progress",
    "clear-text"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/rest/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "dryRunTimeoutMinutes": 20,
  "tempDirName": "../../.stryker-tmp/authz-rbac-rest"
}
