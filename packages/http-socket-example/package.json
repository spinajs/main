{
  "name": "@spinajs/http-socket-example",
  "version": "3.0.16",
  "private": true,
  "description": "Example app for the spinajs WebSocket layer: a notes server with commands, rooms, a resumable snapshot stream and binary blobs, and its client",
  "type": "module",
  "main": "lib/mjs/main.js",
  "engines": {
    "node": ">=18.2"
  },
  "scripts": {
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "compile": "tsc -b tsconfig.mjs.json",
    "start": "node lib/mjs/main.js",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test"
  },
  "license": "MIT",
  "dependencies": {
    "@spinajs/authz": "3.0.16",
    "@spinajs/configuration": "3.0.16",
    "@spinajs/di": "3.0.16",
    "@spinajs/exceptions": "3.0.16",
    "@spinajs/http-socket": "3.0.16",
    "@spinajs/http-socket-client": "3.0.16",
    "@spinajs/http-socket-common": "3.0.16",
    "@spinajs/log": "3.0.16"
  }
}
