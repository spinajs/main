{
  "name": "@spinajs/http-socket-example",
  "version": "3.0.23",
  "private": true,
  "description": "Example app for the spinajs WebSocket layer: a notes server with commands, rooms, a resumable snapshot stream and binary blobs, and its client",
  "type": "module",
  "main": "./lib/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "compile": "tsc -b tsconfig.build.json",
    "start": "node lib/main.js",
    "test": "ts-mocha -p tsconfig.json \"test/**/*.test.ts\"",
    "coverage": "c8 npm run test",
    "bundle": "npm run compile && node scripts/bundle.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@spinajs/authn": "3.0.23",
    "@spinajs/authn-session": "3.0.23",
    "@spinajs/authz": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/http-socket": "3.0.23",
    "@spinajs/http-socket-client": "3.0.23",
    "@spinajs/http-socket-common": "3.0.23",
    "@spinajs/log": "3.0.23"
  },
  "devDependencies": {
    "@spinajs/compiler": "3.0.23",
    "typescript": "~5.9.0"
  },
  "types": "./lib/main.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  },
  "devDependencies": {
    "@spinajs/compiler": "3.0.23",
    "@spinajs/manifest": "3.0.23",
    "esbuild": "^0.28.1"
  }
}
