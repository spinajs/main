{
  "name": "@spinajs/authn-session",
  "version": "3.0.23",
  "description": "Session issuing, stores and codecs for SpinaJS authentication",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./schemas": {
      "types": "./lib/schema.d.ts",
      "import": "./lib/schema.js"
    },
    "./register-schema": {
      "types": "./lib/register-schema.d.ts",
      "import": "./lib/register-schema.js"
    }
  },
  "typesVersions": {
    "*": {
      "schemas": [
        "lib/schema.d.ts"
      ],
      "register-schema": [
        "lib/register-schema.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/authn-session",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "authn"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authn": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/util": "3.0.23",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "@spinajs/authn-testing": "3.0.23",
    "@spinajs/testing": "3.0.23"
  },
  "types": "./lib/index.d.ts"
}
