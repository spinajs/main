{
  "name": "@spinajs/authn-session",
  "version": "3.0.6",
  "description": "Session issuing, stores and codecs for SpinaJS authentication",
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "types": "./lib/mjs/index.d.ts",
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./schemas": {
      "types": "./lib/mjs/schema.d.ts",
      "import": "./lib/mjs/schema.js",
      "require": "./lib/cjs/schema.js"
    },
    "./register-schema": {
      "types": "./lib/mjs/register-schema.d.ts",
      "import": "./lib/mjs/register-schema.js",
      "require": "./lib/cjs/register-schema.js"
    }
  },
  "typesVersions": {
    "*": {
      "schemas": [
        "lib/cjs/schema.d.ts"
      ],
      "register-schema": [
        "lib/cjs/register-schema.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.11"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.mjs.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile && cd ../.. && node node_modules/typescript-7/lib/tsc.js -b packages/authn-session/tsconfig.cjs.json && node scripts/generate-packages-for-modules.mjs",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "nyc npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/authn-session",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "authn"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authn": "3.0.6",
    "@spinajs/configuration": "3.0.6",
    "@spinajs/configuration-common": "3.0.6",
    "@spinajs/di": "3.0.6",
    "@spinajs/exceptions": "3.0.6",
    "@spinajs/log-common": "3.0.6",
    "@spinajs/util": "3.0.6",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "@spinajs/authn-testing": "3.0.6"
  }
}
