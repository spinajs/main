{
  "name": "@spinajs/authn-totp",
  "version": "3.0.23",
  "description": "TOTP multi-factor authentication for SpinaJS",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./schemas": {
      "types": "./lib/schema.d.ts",
      "import": "./lib/schema.js"
    },
    "./db": {
      "types": "./lib/db.d.ts",
      "import": "./lib/db.js"
    },
    "./service": {
      "types": "./lib/service/index.d.ts",
      "import": "./lib/service/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "schemas": [
        "lib/schema.d.ts"
      ],
      "db": [
        "lib/db.d.ts"
      ],
      "service": [
        "lib/service/index.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/authn-totp",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "authn"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authn": "3.0.23",
    "@spinajs/authn-orm": "3.0.23",
    "@spinajs/cli": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/hooks": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/util": "3.0.23",
    "otpauth": "9.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@spinajs/authn-testing": "3.0.23",
    "@spinajs/orm-sqlite": "3.0.23",
    "@spinajs/testing": "3.0.23",
    "@types/qrcode": "^1.5.5"
  },
  "types": "./lib/index.d.ts"
}
