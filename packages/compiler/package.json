{
  "name": "@spinajs/compiler",
  "version": "3.0.23",
  "description": "Build-time analyzer that emits the SpinaJS application manifest",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "lint": "cd ../.. && npm run lint -- packages/compiler"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "compiler",
    "manifest"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "dependencies": {
    "@spinajs/manifest": "3.0.23",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~5.9.0"
  },
  "devDependencies": {
    "@spinajs/authz-http": "3.0.23",
    "@spinajs/authz-orm": "3.0.23",
    "@spinajs/cli": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/http": "3.0.23",
    "@spinajs/http-socket": "3.0.23",
    "@spinajs/http-socket-common": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/queue": "3.0.23",
    "@spinajs/scheduler": "3.0.23",
    "@spinajs/users": "3.0.23",
    "@spinajs/validation": "3.0.23",
    "@types/luxon": "^3.6.1",
    "@types/node": "^22.14.1",
    "luxon": "^3.6.1"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
