{
  "name": "@spinajs/fs-s3",
  "version": "3.0.23",
  "description": "file operations implementation for aws s3 storage",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "watch": "tsc -b tsconfig.build.json -watch",
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/fs-s3",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/exceptions.git"
  },
  "keywords": [
    "di",
    "container",
    "spinajs",
    "di"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/core)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/exceptions/issues"
  },
  "homepage": "https://github.com/spinajs/exceptions#readme",
  "devDependencies": {
    "@types/archiver": "^5.3.1"
  },
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/cloudfront-signer": "^3.821.0",
    "@aws-sdk/lib-storage": "^3.821.0",
    "@aws-sdk/util-utf8-browser": "^3.259.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "iconv-lite": "^0.6.2",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
