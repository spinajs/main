{
  "name": "@spinajs/http-socket-client",
  "version": "3.0.23",
  "description": "Isomorphic socket client for spinajs: connection state, reconnect, commands, events, typed contracts",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/browser.js"
    },
    "./node": {
      "types": "./lib/node/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --incremental false",
    "coverage": "c8 npm run test"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "websocket",
    "socket.io",
    "client"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/http-socket-common": "3.0.23",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "socket.io": "^4.8.1"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
