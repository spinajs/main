{
  "name": "@spinajs/reflection",
  "version": "3.0.23",
  "description": "SpinaJS reflection helpers",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "node": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      },
      "browser": {
        "types": "./lib/index.browser.d.ts",
        "import": "./lib/index.browser.js"
      },
      "default": {
        "types": "./lib/index.d.ts",
        "import": "./lib/index.js"
      }
    },
    "./typescript": {
      "types": "./lib/typescript-compiler.d.ts",
      "import": "./lib/typescript-compiler.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "node ../../node_modules/typescript-7/lib/tsc.js -b tsconfig.build.json",
    "test": "ts-mocha -p tsconfig.json \"test/**/*.test.ts\"",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/reflection",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/core)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/reflection/issues"
  },
  "homepage": "https://github.com/spinajs/reflection#readme",
  "dependencies": {
    "@spinajs/configuration": "3.0.23",
    "@spinajs/configuration-common": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/internal-logger": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/manifest": "3.0.23",
    "@spinajs/util": "3.0.23",
    "lodash": "^4.17.21",
    "typescript-mix": "^3.1.3"
  },
  "peerDependencies": {
    "glob": "^8.1.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "glob": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/testing": "3.0.23",
    "@types/glob": "8.0.1",
    "@types/node": "^18.11.18",
    "glob": "^8.1.0",
    "typescript": "^5.9.2"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
