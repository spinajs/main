{
  "name": "@spinajs/email-verification",
  "version": "3.0.23",
  "description": "Email domain verification: domain lists, DNS/MX, RDAP domain age and HTTP domain-check APIs, with pluggable verdict stores",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./register-schema": {
      "types": "./lib/register-schema.d.ts",
      "import": "./lib/register-schema.js"
    },
    "./scheduler": {
      "types": "./lib/scheduler.d.ts",
      "import": "./lib/scheduler.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "import": "./lib/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "register-schema": [
        "lib/register-schema.d.ts"
      ],
      "scheduler": [
        "lib/scheduler.d.ts"
      ],
      "testing": [
        "lib/testing/index.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/email-verification",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "email",
    "verification",
    "disposable"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/cli": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/log": "3.0.23"
  },
  "peerDependencies": {
    "@spinajs/scheduler": "3.0.23",
    "chai": "^4.3.7",
    "mocha": "^10.2.0"
  },
  "peerDependenciesMeta": {
    "@spinajs/scheduler": {
      "optional": true
    },
    "chai": {
      "optional": true
    },
    "mocha": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/scheduler": "3.0.23",
    "@types/node": "^22.14.1",
    "chai": "^4.3.7",
    "mocha": "^10.2.0"
  },
  "types": "./lib/index.d.ts"
}
