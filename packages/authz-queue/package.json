{
  "name": "@spinajs/authz-queue",
  "version": "3.0.23",
  "description": "Queue integration for SpinaJS authorization",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./jobs": {
      "types": "./lib/job/index.d.ts",
      "import": "./lib/job/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "jobs": [
        "lib/job/index.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/authz-queue",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "authz"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authz": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/queue": "3.0.23",
    "@spinajs/util": "3.0.23"
  },
  "peerDependencies": {
    "@spinajs/authz-orm": "3.0.23"
  },
  "peerDependenciesMeta": {
    "@spinajs/authz-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/authz-orm": "3.0.23",
    "@spinajs/authz-rbac": "3.0.23",
    "@spinajs/authz-testing": "3.0.23",
    "@spinajs/orm-sqlite": "3.0.23"
  },
  "types": "./lib/index.d.ts"
}
