{
  "name": "@spinajs/upload",
  "version": "3.0.23",
  "description": "Resumable, verified chunked uploads for SpinaJS: sessions, parts, assembly and cleanup",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./scheduler": {
      "types": "./lib/scheduler.d.ts",
      "import": "./lib/scheduler.js"
    },
    "./http": {
      "types": "./lib/http/index.d.ts",
      "import": "./lib/http/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "scheduler": [
        "lib/scheduler.d.ts"
      ],
      "http": [
        "lib/http/index.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json --timeout 60000 \"test/**/*.test.ts\"",
    "coverage": "nyc npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/upload",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "upload",
    "resumable",
    "chunked"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/cli": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/hooks": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/orm": "3.0.23",
    "@spinajs/queue": "3.0.23",
    "file-type": "^20.5.0",
    "luxon": "^3.6.1",
    "mime-types": "^3.0.2"
  },
  "peerDependencies": {
    "@spinajs/http": "3.0.23",
    "@spinajs/scheduler": "3.0.23",
    "@spinajs/validation": "3.0.23"
  },
  "peerDependenciesMeta": {
    "@spinajs/http": {
      "optional": true
    },
    "@spinajs/scheduler": {
      "optional": true
    },
    "@spinajs/validation": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/http": "3.0.23",
    "@spinajs/orm-mysql": "3.0.23",
    "@spinajs/orm-postgres": "3.0.23",
    "@spinajs/orm-sqlite": "3.0.23",
    "@spinajs/scheduler": "3.0.23",
    "@spinajs/testing": "3.0.23",
    "@spinajs/validation": "3.0.23",
    "@types/luxon": "^3.4.2",
    "@types/mime-types": "^3.0.1"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
