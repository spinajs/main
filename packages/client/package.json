{
  "name": "@spinajs/client",
  "version": "3.0.23",
  "description": "Typed HTTP and socket client for SpinaJS applications, generated from the application manifest",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime/index.d.ts",
      "import": "./lib/runtime/index.js"
    },
    "./formats": {
      "types": "./lib/formats/index.d.ts",
      "import": "./lib/formats/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json \"test/**/*.test.ts\"",
    "coverage": "c8 npm run test",
    "lint": "cd ../.. && npm run lint -- packages/client"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "client",
    "fetch",
    "manifest"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "dependencies": {
    "@spinajs/manifest": "3.0.23",
    "json-schema-to-typescript": "^16.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "swr": "^2.1.0",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "swr": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spinajs/authz-http": "3.0.23",
    "@spinajs/compiler": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/fs": "3.0.23",
    "@spinajs/http": "3.0.23",
    "@spinajs/http-socket-common": "3.0.23",
    "@spinajs/intl": "3.0.23",
    "@spinajs/testing": "3.0.23",
    "@spinajs/validation": "3.0.23",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "chai-as-promised": "^7.1.1",
    "esbuild": "^0.28.1",
    "fast-check": "^4.10.2",
    "typescript": "~5.9.0"
  },
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
