{
  "name": "@spinajs/fs",
  "version": "3.0.23",
  "description": "wrapper for file operations",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "watch": "tsc -b tsconfig.build.json -watch",
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/fs",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/exceptions.git"
  },
  "keywords": [
    "di",
    "container",
    "spinajs",
    "di"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/core)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/exceptions/issues"
  },
  "homepage": "https://github.com/spinajs/exceptions#readme",
  "dependencies": {
    "@spinajs/cli": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/log-common": "3.0.23",
    "@spinajs/util": "3.0.23",
    "archiver": "^5.3.1",
    "cron": "^2.2.0",
    "exiftool-vendored": "^36.0.0",
    "file-type": "^20.5.0",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@spinajs/testing": "3.0.23",
    "@types/archiver": "^5.3.1",
    "@types/cron": "^2.0.0",
    "@types/luxon": "^3.6.1",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^9.0.0"
  },
  "types": "./lib/index.d.ts",
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
