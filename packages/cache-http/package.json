{
  "name": "@spinajs/cache-http",
  "version": "3.0.23",
  "description": "Response cache for SpinaJS http routes: @ResponseCache stores the JSON reply of a GET route per principal and answers later requests from it",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.build.json",
    "clean": "rimraf lib/ && rimraf tsconfig.build.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json --exit \"test/**/*.test.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/cache-http"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "cache",
    "http",
    "response cache"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/cache": "3.0.23",
    "@spinajs/configuration": "3.0.23",
    "@spinajs/di": "3.0.23",
    "@spinajs/exceptions": "3.0.23",
    "@spinajs/http": "3.0.23",
    "@spinajs/log": "3.0.23",
    "@spinajs/principal": "3.0.23"
  },
  "devDependencies": {
    "@spinajs/fs": "3.0.23",
    "@spinajs/intl-http": "3.0.23",
    "@spinajs/testing": "3.0.23",
    "@types/express": "^5.0.1",
    "express": "^5.1.0",
    "fast-check": "^4.10.2"
  },
  "spinajs": {
    "manifest": "lib/manifest.fragment.json"
  }
}
