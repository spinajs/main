{
  "name": "@spinajs/authz-orm",
  "version": "3.0.21",
  "description": "ORM resources, closure table and list helpers for SpinaJS authorization",
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "exports": {
    ".": {
      "types": "./lib/mjs/index.d.ts",
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./scope-attributes": {
      "types": "./lib/mjs/scope-attributes/index.d.ts",
      "import": "./lib/mjs/scope-attributes/index.js",
      "require": "./lib/cjs/scope-attributes/index.js"
    },
    "./audit": {
      "types": "./lib/mjs/audit/index.d.ts",
      "import": "./lib/mjs/audit/index.js",
      "require": "./lib/cjs/audit/index.js"
    },
    "./plan": {
      "types": "./lib/mjs/plan/index.d.ts",
      "import": "./lib/mjs/plan/index.js",
      "require": "./lib/cjs/plan/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "scope-attributes": [
        "lib/cjs/scope-attributes/index.d.ts"
      ],
      "audit": [
        "lib/cjs/audit/index.d.ts"
      ],
      "plan": [
        "lib/cjs/plan/index.d.ts"
      ]
    }
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.11"
  },
  "scripts": {
    "build": "npm run clean && npm run compile",
    "compile": "tsc -b tsconfig.mjs.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "rimraf": "./node_modules/rimraf/bin.js",
    "clean": "rimraf lib/ && rimraf tsconfig.tsbuildinfo",
    "pretest": "npm run compile",
    "test": "ts-mocha -p tsconfig.json test/**/*.test.ts",
    "coverage": "c8 npm run test",
    "build-docs": "rimraf docs && typedoc --options typedoc.json src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "cd ../.. && npm run lint -- packages/authz-orm",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src"
  },
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spinajs/main.git"
  },
  "keywords": [
    "spinajs",
    "authz"
  ],
  "author": "SpinaJS <spinajs@coderush.pl> (https://github.com/spinajs/main)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/spinajs/main/issues"
  },
  "homepage": "https://github.com/spinajs/main#readme",
  "dependencies": {
    "@spinajs/authz": "3.0.21",
    "@spinajs/cli": "3.0.21",
    "@spinajs/configuration": "3.0.21",
    "@spinajs/di": "3.0.21",
    "@spinajs/exceptions": "3.0.21",
    "@spinajs/orm": "3.0.21",
    "luxon": "^3.6.1"
  },
  "devDependencies": {
    "@spinajs/authz-testing": "3.0.21",
    "@spinajs/log": "3.0.21",
    "@spinajs/orm-postgres": "3.0.21",
    "@spinajs/orm-sqlite": "3.0.21",
    "@types/luxon": "^3.6.1"
  }
}
