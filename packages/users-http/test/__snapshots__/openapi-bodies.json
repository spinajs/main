{
  "Security_banUser": {
    "route": "POST /users/security/ban/{user}",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "description": "Why the account is banned. Stored in user metadata.",
                "maxLength": 255
              },
              "duration": {
                "type": "number",
                "description": "Ban duration in seconds. Defaults to 24h.",
                "minimum": 1
              },
              "reauthPassword": {
                "type": "string",
                "description": "The caller's password, for fresh authentication"
              }
            }
          }
        }
      }
    }
  },
  "UserMetadataController_addMetadata": {
    "route": "POST /user/metadata",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "Key",
              "Type"
            ],
            "properties": {
              "Key": {
                "type": "string",
                "description": "Metadata key (dot-notation supported, e.g. user:niceName)",
                "minLength": 6,
                "maxLength": 255
              },
              "Value": {
                "type": "string",
                "description": "Metadata value stored as a string regardless of Type"
              },
              "Type": {
                "type": "string",
                "description": "Declared value type used for serialization/deserialization",
                "enum": [
                  "number",
                  "float",
                  "string",
                  "json",
                  "boolean",
                  "datetime"
                ]
              }
            }
          }
        }
      }
    }
  },
