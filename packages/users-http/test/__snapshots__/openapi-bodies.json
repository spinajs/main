  "Users_addUser": {
    "route": "POST /users",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "Login",
              "Email",
              "Role"
            ],
            "properties": {
              "Login": {
                "type": "string",
                "description": "Unique login name (3–32 characters)",
                "minLength": 3,
                "maxLength": 32
              },
              "Email": {
                "type": "string",
                "format": "email",
                "description": "Unique email address"
              },
              "Role": {
                "description": "RBAC role to assign to the user, or a list of roles",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^(?!(?:true|false)$)(?!-?\\d)\\S(?:.*\\S)?$"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^(?!(?:true|false)$)(?!-?\\d)\\S(?:.*\\S)?$"
                    }
                  }
                ]
              },
              "Metadata": {
                "type": "object",
                "description": "Optional key-value metadata to attach to the user account",
                "additionalProperties": true
              }
            }
          }
        }
      }
    }
  },
  "Users_updateUser": {
