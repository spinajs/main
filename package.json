{
  "name": "root",
  "private": true,
  "scripts": {
    "clean": "npm run clean --workspace=packages",
    "pretest": "node node_modules/typescript-7/lib/tsc.js -b tsconfig.build.json",
    "test": "npm run test --workspace=packages",
    "build": "npm run clean && node node_modules/typescript-7/lib/tsc.js -b tsconfig.build.json && node node_modules/typescript-7/lib/tsc.js -b tsconfig.build.cjs.json && npm run copy-static && npm run prepare-module-support",
    "build:sh": "bash scripts/build.sh",
    "watch": "node node_modules/typescript-7/lib/tsc.js -b tsconfig.build.json tsconfig.build.cjs.json --watch --preserveWatchOutput",
    "watch:esm": "node node_modules/typescript-7/lib/tsc.js -b tsconfig.build.json --watch --preserveWatchOutput",
    "watch:cjs": "node node_modules/typescript-7/lib/tsc.js -b tsconfig.build.cjs.json --watch --preserveWatchOutput",
    "publish": "npm run build && node scripts/publish-all.mjs",
    "publish:dry-run": "node scripts/publish-all.mjs --dry-run",
    "copy-static": "cpx \"packages/http/src/views/**/*\" packages/http/lib/views && cpx \"packages/http/src/static/**/*\" packages/http/lib/static && cpx \"packages/http-swagger/src/views/**/*.{pug,js}\" packages/http-swagger/lib/views",
    "prepare-module-support": "node scripts/generate-packages-for-modules.mjs",
    "docs:check": "node scripts/check-doc-samples.mjs",
    "docs:gitignore": "node scripts/sync-docs-gitignore.mjs",
    "lint": "node node_modules/typescript-7/lib/tsc.js -b packages/eslint-plugin-authz/tsconfig.mjs.json && node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --cache",
    "lint:prune": "node node_modules/typescript-7/lib/tsc.js -b packages/eslint-plugin-authz/tsconfig.mjs.json && node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --prune-suppressions",
    "deps": "depcruise packages --config .dependency-cruiser.cjs --ignore-known --output-type err",
    "deps:baseline": "depcruise packages --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "knip": "knip",
    "check:packages": "node scripts/check-packages.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "link": "powershell -NoProfile -ExecutionPolicy Bypass -File link-all.ps1",
    "link:sh": "bash link-all.sh"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "luxon": "^3.6.1"
  },
  "devDependencies": {
